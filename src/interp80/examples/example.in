/* LOAD PROGRAM AND SYMBOL TABLE FROM I/O CHANNEL 6 */
LOAD 6 6.
/* SWITCH NUMBER BASE TO 16 */
BASE HEX.
/* DISPLAY THE SYMBOL TABLE */
DISPLAY SYMBOLS.
/* DISPLAY 8080 INSTUCTIONS */
DISPLAY MEMORY 100H TO 110H CODE.
/* SET BREAKPOINT AT LABEL L1 */
REFER L1.
/* SET POGRAM COUNTER TO START OF PROGRAM */
SET PC = START.
/* DISPLAY CPU REGISTERS */
DISPLAY CPU.
/* EXECUTE PROGRAM FOR 1000 CYCLES */
GO 1000.
/* PROGRAM STOPPED AT BREAKPOINT, DISPLAY REGISTERS */
DISPLAY CPU.
/* EXECUTE FOR ANOTHER 1000 CYCLES */
GO 1000.
/* PROGRAM RAN INTO HALT INSTRUCTION, DISPLAY REGISTERS */
DISPLAY CPU.
/* END OF COMMAND STREAM, TERMINATE EMULATION */
$EOF
