 8080 PLM1 VERS 2.0
                   
 00001  1   /*
 00002  1                          SAMPLE  PL/M  PROGRAM
 00003  1
 00004  1       THIS PROGRAM CALCULATES AND PRINTS OUT THE SQUARE ROOTS OF
 00005  1       ALL INTEGERS BETWEEN 1 AND 1000.
 00006  1                                                                  */
 00007  1
 00008  1   DECLARE CR LITERALLY '0DH', LF LITERALLY '0AH', TRUE LITERALLY '1',
 00009  1           FALSE LITERALLY '0';
 00010  1
 00011  1   100H:  /*  IS THE ORIGIN OF THIS PROGRAM */
 00012  1
 00013  1   SQUARE$ROOT: PROCEDURE(X) BYTE;
 00014  2       DECLARE (X,Y,Z) ADDRESS;
 00015  2       Y=X; Z=SHR(X+1,1);
 00016  2           DO WHILE Y<>Z;
 00017  2           Y=Z; Z=SHR(X/Y + Y + 1, 1);
 00018  3           END;
 00019  2       RETURN Y;
 00020  2       END SQUAREROOT;
 00021  1
 00022  1   /* PROCEDURE TO CALL BDOS FUNCTIONS */
 00023  1   BDOS: PROCEDURE(FUNC,PARM);
 00024  2       DECLARE FUNC BYTE;
 00025  2       DECLARE PARM ADDRESS;
 00026  2       DECLARE BDOS$JUMP LITERALLY '05H';
 00027  2       GO TO BDOS$JUMP;
 00028  2       END BDOS;
 00029  1
 00030  1   /* PRINT USING BDOS */
 00031  1   PRINT$CHAR: PROCEDURE(CHAR);
 00032  2       DECLARE CHAR BYTE;
 00033  2       CALL BDOS(2,CHAR);
 00034  2       END PRINT$CHAR;
 00035  1
 00036  1   PRINT$STRING: PROCEDURE(NAME,LENGTH);
 00037  2       DECLARE NAME ADDRESS,
 00038  2           (LENGTH,I,CHAR BASED NAME) BYTE;
 00039  2           DO I = 0 TO LENGTH-1;
 00040  2           CALL PRINT$CHAR(CHAR(I));
 00041  3           END;
 00042  2       END PRINT$STRING;
 00043  1
 00044  1   PRINT$NUMBER: PROCEDURE(NUMBER,BASE,CHARS,ZERO$SUPPRESS);
 00045  2       DECLARE NUMBER ADDRESS, (BASE,CHARS,ZERO$SUPPRESS,I,J) BYTE;
 00046  2       DECLARE TEMP(16) BYTE;
 00047  2       IF CHARS > LAST(TEMP) THEN CHARS = LAST(TEMP);
 00048  2           DO I = 1 TO CHARS;
 00049  2           J=NUMBER MOD BASE + '0';
 00050  3           IF J > '9' THEN J = J + 7;
 00051  3           IF ZERO$SUPPRESS AND I <> 1 AND NUMBER = 0 THEN
 00052  3               J = ' ';
 00053  3           TEMP(LENGTH(TEMP)-I) = J;
 00054  3           NUMBER = NUMBER / BASE;
 00055  3           END;
 00056  2       CALL PRINT$STRING(.TEMP + LENGTH(TEMP) - CHARS,CHARS);
 00057  2       END PRINT$NUMBER;
 00058  1
 00059  1   DECLARE I ADDRESS,
 00060  1       CRLF LITERALLY 'CR,LF',
 00061  1       HEADING DATA (CRLF,LF,LF,
 00062  1       '                        TABLE OF SQUARE ROOTS', CRLF,LF,
 00063  1       ' VALUE  ROOT VALUE  ROOT VALUE  ROOT VALUE  ROOT VALUE  ROOT',
 00064  1       CRLF,LF);
 00065  1
 00066  1       /* SILENCE TTY AND PRINT COMPUTED VALUES */
 00067  1       DO I = 1 TO 1000;
 00068  1       IF I MOD 5 = 1 THEN
 00069  2           DO; IF I MOD 250 = 1 THEN
 00070  3               CALL PRINT$STRING(.HEADING,LENGTH(HEADING));
 00071  3               ELSE
 00072  3               CALL PRINT$STRING(.(CR,LF),2);
 00073  3           END;
 00074  2       CALL PRINT$NUMBER(I,10,6,TRUE /* TRUE SUPPRESSES LEADING ZEROES */);
 00075  2       CALL PRINT$NUMBER(SQUARE$ROOT(I), 10,6, TRUE);
 00076  2       END;
 00077  1
 00078  1       /* TERMINATE PROGRAM */
 00079  1       CALL BDOS(0,0);
 00080  1
 00081  1   EOF
 NO PROGRAM ERRORS
  
